# === AWS Configuration (Required for AI features) ===
# Get from AWS IAM console: https://console.aws.amazon.com/iam/
# Required permissions: bedrock:InvokeModel, bedrock:Converse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# === Bedrock Model ===
# Amazon Nova Pro for multimodal reasoning
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# === Application Mode ===
# Set to "false" ONLY when AWS credentials are configured
# Demo mode uses synthetic AI responses but real database/tools
DEMO_MODE=true

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# === Frontend ===
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
